<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notficatio"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Notification icon -->
    <ImageView
        android:id="@+id/notification_ion"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/logoo"/>

    <!-- Notification title and artist -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="5dp"
        android:paddingRight="5dp">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Song Title"
            android:textSize="15sp"
            android:textColor="@android:color/white"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/notification_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Artist Name"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            android:ellipsize="end"/>

    </LinearLayout>

    <!-- Notification play, pause, and next buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notification_previous"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_stop_circle_24"/>

        <ImageView
            android:id="@+id/notification_play_pause"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_play_arrow_24"/>

        <ImageView
            android:id="@+id/notification_next"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_visibilit"/>

    </LinearLayout>

    <!-- Notification progress bar -->
    <ProgressBar
        android:id="@+id/notification_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:progress="0"
        android:indeterminate="false"
        android:visibility="invisible"/>

</LinearLayout>
